<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0" ExtensionBundleId="com.uiscore.bridge" ExtensionBundleVersion="0.1.0" ExtensionBundleName="Uiscore Bridge" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.uiscore.bridge.panel" Version="0.1.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- After Effects 2022 (22.0) and newer -->
      <Host Name="AEFT" Version="[22.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.uiscore.bridge.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Uiscore Bridge</Menu>
          <Geometry>
            <Size><Height>460</Height><Width>320</Width></Size>
            <MinSize><Height>240</Height><Width>240</Width></MinSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./img/icon-normal.png</Icon>
            <Icon Type="RollOver">./img/icon-rollover.png</Icon>
            <Icon Type="DarkNormal">./img/icon-dark-normal.png</Icon>
            <Icon Type="DarkRollOver">./img/icon-dark-rollover.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
